# Brand — change this one value to re-skin the API's identity.
BRAND_NAME=Orbit

# PostgreSQL connection string.
DATABASE_URL=postgresql+psycopg2://orbit:orbit@localhost:5432/orbit

# "demo" needs no API key and runs everywhere for free. "live" calls Gemini.
AI_MODE=demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Abuse / cost safeguards.
AI_DAILY_LIMIT=5
AI_MAX_PROMPT_LENGTH=300
AI_MAX_RESPONSE_LENGTH=1200
AI_REQUEST_TIMEOUT_SECONDS=15
AI_CACHE_TTL_SECONDS=3600

# Comma-separated list of frontend origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5180

MAX_REQUEST_BODY_BYTES=16384
ENVIRONMENT=development
