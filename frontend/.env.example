# Backend base URL. Defaults to /api, which the dev server proxies to
# localhost:8000 (see vite.config.js). Set this to your deployed backend's
# URL in production, e.g. https://orbit-api.onrender.com/api
VITE_API_BASE_URL=/api

# Change once to re-skin the whole site (see src/config/brand.js).
VITE_BRAND_NAME=Orbit
